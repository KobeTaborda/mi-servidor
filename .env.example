# Copie este archivo como .env y ponga sus datos de la base de datos

# Motor de base de datos: mysql | mssql  (es lo único que se cambia para usar otro motor)
DB_TYPE=mysql

PORT=3000
DB_HOST=localhost
# DB_PORT=3306 (mysql) / 1433 (mssql). Si se omite, se usa el puerto por defecto del motor
DB_USER=root
DB_PASSWORD=
DB_NAME=formulario_db
